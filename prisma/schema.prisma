generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  role               Role
  createdAt          DateTime @default(now())
  needPasswordChange Boolean  @default(true)
}

model Student {
  id          String         @id @default(uuid())
  name        String
  classId     String
  userId      String?
  attendances Attendance[]
  payments    Payment[]
  performance PerformanceAI?
  results     Result[]
  class       Class          @relation(fields: [classId], references: [id])
}

model Teacher {
  id   String @id @default(uuid())
  name String
}

model Class {
  id       String    @id @default(uuid())
  name     String
  exams    Exam[]
  students Student[]
  subjects Subject[]
}

model Subject {
  id      String   @id @default(cuid())
  name    String
  classId String
  results Result[]
  class   Class    @relation(fields: [classId], references: [id])
}

model Attendance {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime
  status    String
  student   Student  @relation(fields: [studentId], references: [id])
}

model Result {
  id        String  @id @default(uuid())
  studentId String
  subjectId String
  marks     Int
  examId    String?
  exam      Exam?   @relation(fields: [examId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  amount        Float
  status        String
  transactionId String   @unique
  purpose       String
  studentId     String
  paymentDate   DateTime @default(now())
  examId        String?
  exam          Exam?    @relation(fields: [examId], references: [id])
  student       Student  @relation(fields: [studentId], references: [id])
}

model Exam {
  id        String    @id @default(uuid())
  title     String
  examDate  DateTime
  feeAmount Float     @default(0.0)
  classId   String?
  class     Class?    @relation(fields: [classId], references: [id])
  payments  Payment[]
  results   Result[]
}

model PerformanceAI {
  id             String   @id @default(uuid())
  studentId      String   @unique
  insightText    String
  predictedGrade String?
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}
